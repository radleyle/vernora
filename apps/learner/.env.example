# Copy to .env (never commit .env).
# EXPO_PUBLIC_* values are compiled into the browser bundle — never put
# secrets here. The publishable/anon key is designed to be public.

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Dashboard -> Project Settings -> API Keys -> publishable (or legacy anon) key
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://localhost:8080
