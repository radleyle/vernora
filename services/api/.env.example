# Copy to .env (never commit .env) or export in your shell before running.

# --- Database (defaults in application.yaml already match local Docker) ---
# DB_URL=jdbc:postgresql://localhost:5433/vernora
# DB_USER=vernora
# DB_PASSWORD=vernora

# --- Supabase Auth ---
# <project-ref> is in the dashboard URL: supabase.com/dashboard/project/<project-ref>
# Verify the URL below returns {"keys":[{...}]} (not an empty keys array).
# https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URI=
