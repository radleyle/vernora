{
  "id": "korean-core",
  "version": 1,
  "language": "ko",
  "explanationLanguages": ["en", "vi"],
  "title": { "en": "Korean", "vi": "Tiếng Hàn" },
  "concepts": [
    {
      "id": "greeting-people",
      "name": { "en": "Greeting people", "vi": "Chào hỏi" },
      "explanation": {
        "en": "Koreans choose a greeting based on the relationship. 안녕하세요 (annyeonghaseyo) is the safe polite greeting for almost everyone. 안녕 (annyeong) is casual and only for close friends or children — using it with a stranger or elder is rude.",
        "vi": "Người Hàn chọn cách chào dựa trên mối quan hệ. 안녕하세요 (annyeonghaseyo) là lời chào lịch sự an toàn với hầu hết mọi người. 안녕 (annyeong) là cách chào thân mật, chỉ dùng với bạn thân hoặc trẻ em."
      },
      "examples": [
        {
          "korean": "안녕하세요, 선생님!",
          "meaning": { "en": "Hello, teacher! (polite)" }
        },
        {
          "korean": "안녕!",
          "meaning": { "en": "Hi! (casual, close friends only)" }
        }
      ]
    },
    {
      "id": "introducing-yourself",
      "name": { "en": "Introducing yourself" },
      "explanation": {
        "en": "To say \"I am ___\", use 저는 ___예요 (jeoneun ___-yeyo). 저는 means \"as for me\" and ___예요 means \"am/is\". Korean puts the verb at the end of the sentence."
      },
      "examples": [
        {
          "korean": "저는 민수예요.",
          "meaning": { "en": "I am Minsu." }
        }
      ]
    }
  ],
  "vocabulary": [
    {
      "id": "annyeonghaseyo",
      "korean": "안녕하세요",
      "romanization": "annyeonghaseyo",
      "meaning": { "en": "hello (polite)", "vi": "xin chào (lịch sự)" },
      "formality": "POLITE"
    },
    {
      "id": "annyeong",
      "korean": "안녕",
      "romanization": "annyeong",
      "meaning": { "en": "hi / bye (casual)", "vi": "chào (thân mật)" },
      "formality": "CASUAL",
      "notes": { "en": "Only with close friends or people younger than you." }
    },
    {
      "id": "gamsahamnida",
      "korean": "감사합니다",
      "romanization": "gamsahamnida",
      "meaning": { "en": "thank you (formal)", "vi": "cảm ơn (trang trọng)" },
      "formality": "FORMAL"
    },
    {
      "id": "ne",
      "korean": "네",
      "romanization": "ne",
      "meaning": { "en": "yes", "vi": "vâng" },
      "formality": "POLITE"
    },
    {
      "id": "aniyo",
      "korean": "아니요",
      "romanization": "aniyo",
      "meaning": { "en": "no", "vi": "không" },
      "formality": "POLITE"
    },
    {
      "id": "mannaseo-bangawoyo",
      "korean": "만나서 반가워요",
      "romanization": "mannaseo bangawoyo",
      "meaning": { "en": "nice to meet you", "vi": "rất vui được gặp bạn" },
      "formality": "POLITE"
    }
  ],
