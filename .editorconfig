# EditorConfig keeps formatting consistent across editors and languages.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java conventions use 4-space indentation
[*.java]
indent_size = 4

# Markdown uses trailing spaces for hard line breaks
[*.md]
trim_trailing_whitespace = false
